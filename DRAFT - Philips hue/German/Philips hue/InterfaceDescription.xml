<?xml version="1.0" encoding="utf-8"?>
<SDVINTERFACE VERSION="1">
	<INFO NAME="PhilipsHue" AUTHOR="Albrecht" DESCRIPTION="Philips Hue Bridge Anschluss: Lampen, Gruppen, Szenen, Sensoren, Automationen und Anwesenheit (Geofencing)" VERSION="1" APIVERSION="5" POLLTIME="1000"/>
	<PVITEMS>
		<PVFOLDER SCRIPTNAME="CONFIGURATION" CREATIONTYPE="Unique" USERTYPE="configuration_t" DEFAULTNAME="Konfiguration">
			<PVSTRING  SCRIPTNAME="BRIDGE_IP"        DEFAULTNAME="Bridge IP-Adresse"      ACCESS="Read/Write" SAVE="1" EXPORT="1" DESCRIPTION="IP-Adresse der Hue Bridge im lokalen Netzwerk, z.B. 192.168.1.20"/>
			<PVBINARY  SCRIPTNAME="AUTO_DISCOVER_IP" UNIT0="aus" UNIT1="ein" DEFAULTNAME="Bridge-IP automatisch aktualisieren" ACCESS="Read/Write" SAVE="1" EXPORT="1" DESCRIPTION="Bei Verbindungsverlust wird die aktuelle Bridge-IP automatisch über discovery.meethue.com (Cloud-Dienst von Philips) ermittelt und übernommen, falls sie sich geändert hat. Erfordert Internetzugang - ohne Internetzugang ausgeschaltet lassen und die IP manuell pflegen bzw. per DHCP-Reservierung im Router fixieren"/>
			<PVBINARY  SCRIPTNAME="PAIR_REQUEST" UNIT0="-" UNIT1="Start" DEFAULTNAME="Pairing starten" ACCESS="Write" SAVE="0" EXPORT="1" DESCRIPTION="1 schreiben, danach innerhalb von 5 Minuten den Link-Button auf der Bridge drücken"/>
			<PVSTRING  SCRIPTNAME="API_KEY"          DEFAULTNAME="API-Key (Username)"     ACCESS="Read/Write" SAVE="1" EXPORT="1" DESCRIPTION="Hue Application Key. Wird beim Pairing automatisch gesetzt, kann alternativ manuell eingetragen werden"/>
			<PVBINARY  SCRIPTNAME="DUMP_INVENTORY" UNIT0="-" UNIT1="Start" DEFAULTNAME="Inventar auflisten" ACCESS="Write" SAVE="0" EXPORT="1" DESCRIPTION="1 schreiben: fragt alle Lampen/Gruppen/Szenen/Sensoren/Regeln der Bridge ab und listet sie mit Hue-ID in STATUS.Inventar auf"/>
			<PVBINARY  SCRIPTNAME="ASSIGN_IDS" UNIT0="-" UNIT1="Start" DEFAULTNAME="IDs automatisch zuordnen" ACCESS="Write" SAVE="0" EXPORT="1" DESCRIPTION="1 schreiben: ordnet den bereits im Editor angelegten Instanzen (Lichter/Räume/Szenen/Sensoren/Automationen) der Reihe nach die auf der Bridge gefundenen IDs zu - Instanz 1 erhält die erste gefundene ID, Instanz 2 die zweite usw. Nur leere ID-Felder werden befüllt, vorhandene Zuordnungen bleiben erhalten"/>
			<PVBINARY  SCRIPTNAME="REFRESH_STATES" UNIT0="-" UNIT1="Start" DEFAULTNAME="Status aktualisieren" ACCESS="Write" SAVE="0" EXPORT="1" DESCRIPTION="1 schreiben: fragt Zustaende aller konfigurierten Lampen/Gruppen/Sensoren/Szenen/Automationen (und ggf. Anwesenheit) einmalig von der Bridge ab. Laeuft sonst nur einmalig beim Start - die Anlage aendert sich selten"/>
			<PVBINARY  SCRIPTNAME="GEOFENCE_ENABLED" UNIT0="aus" UNIT1="ein" DEFAULTNAME="Anwesenheit (Geofencing) abfragen" ACCESS="Read/Write" SAVE="1" EXPORT="1" DESCRIPTION="Fragt den Home/Away-Status der Hue-App via CLIP v2 (HTTPS) ab. Benötigt, dass die JVP HTTP-Ressource HTTPS zu einem selbstsignierten Zertifikat zulässt"/>
			<PVBINARY  SCRIPTNAME="CLEAR_DEBUG_LOG" UNIT0="-" UNIT1="Start" DEFAULTNAME="Debug-Log löschen" ACCESS="Write" SAVE="0" EXPORT="1" DESCRIPTION="1 schreiben, um das Debug-Log zurückzusetzen"/>
		</PVFOLDER>

		<PVFOLDER SCRIPTNAME="STATUS" CREATIONTYPE="Unique" USERTYPE="status_t" DEFAULTNAME="Status">
			<PVSTRING SCRIPTNAME="PAIRING_STATE" DEFAULTNAME="Pairing-Status" ACCESS="Read" SAVE="0" EXPORT="1" DESCRIPTION="Textstatus des Kopplungsvorgangs"/>
			<PVBINARY SCRIPTNAME="CONNECTED"     UNIT0="getrennt" UNIT1="verbunden" DEFAULTNAME="Verbindung" ACCESS="Read" SAVE="0" EXPORT="1" DESCRIPTION="Bridge aktuell erreichbar"/>
			<PVSTRING SCRIPTNAME="INVENTORY_LIGHTS"      DEFAULTNAME="Inventar Lampen" ACCESS="Read" SAVE="0" EXPORT="1" DESCRIPTION="Liste aller Lampen (Hue-ID + Name), erzeugt durch CONFIGURATION.DUMP_INVENTORY"/>
			<PVSTRING SCRIPTNAME="INVENTORY_GROUPS"      DEFAULTNAME="Inventar Gruppen" ACCESS="Read" SAVE="0" EXPORT="1" DESCRIPTION="Liste aller Gruppen/Räume (Hue-ID + Name), erzeugt durch CONFIGURATION.DUMP_INVENTORY"/>
			<PVSTRING SCRIPTNAME="INVENTORY_SCENES"      DEFAULTNAME="Inventar Szenen" ACCESS="Read" SAVE="0" EXPORT="1" DESCRIPTION="Liste aller Szenen (Hue-ID + Name + Ziel-Gruppe), erzeugt durch CONFIGURATION.DUMP_INVENTORY"/>
			<PVSTRING SCRIPTNAME="INVENTORY_SENSORS"     DEFAULTNAME="Inventar Sensoren" ACCESS="Read" SAVE="0" EXPORT="1" DESCRIPTION="Liste aller Sensoren (Hue-ID + Name + Typ), erzeugt durch CONFIGURATION.DUMP_INVENTORY"/>
			<PVSTRING SCRIPTNAME="INVENTORY_AUTOMATIONS" DEFAULTNAME="Inventar Automationen" ACCESS="Read" SAVE="0" EXPORT="1" DESCRIPTION="Liste aller Regeln/Automationen (Hue-ID + Name), erzeugt durch CONFIGURATION.DUMP_INVENTORY"/>
			<PVTIME   SCRIPTNAME="LAST_UPDATE"   UNIT0="" DEFAULTNAME="Letztes Update" ACCESS="Read" SAVE="0" EXPORT="1"/>
			<PVBINARY SCRIPTNAME="ANY_PRESENT"   UNIT0="niemand zuhause" UNIT1="jemand zuhause" DEFAULTNAME="Anwesenheit" ACCESS="Read" SAVE="0" EXPORT="1" DESCRIPTION="Mind. ein in der Hue-App registriertes Gerät meldet 'zuhause' (nur bei aktivem Geofencing)"/>
			<PVSTRING SCRIPTNAME="LAST_ERROR"    DEFAULTNAME="Letzter Fehler" ACCESS="Read" SAVE="0" EXPORT="1"/>
			<PVSTRING SCRIPTNAME="DEBUG_LOG"     DEFAULTNAME="Debug-Log" ACCESS="Read" SAVE="0" EXPORT="1" DESCRIPTION="Rollierendes Log der letzten E:trace-Meldungen zum Kopieren bei der Fehlersuche"/>
		</PVFOLDER>

		<PVFOLDER SCRIPTNAME="LIGHTS_ROOT" CREATIONTYPE="Unique" USERTYPE="lights_root_t" DEFAULTNAME="Lichter">
			<PVFOLDER SCRIPTNAME="Light" CREATIONTYPE="Multiple" USERTYPE="light_t" DEFAULTNAME="Lampe">
				<PVSTRING SCRIPTNAME="LIGHT_HUE_ID"     DEFAULTNAME="Hue Light-ID" ACCESS="Read/Write" SAVE="1" EXPORT="1" DESCRIPTION="ID der Lampe auf der Bridge (siehe Log nach dem ersten Pairing)"/>
				<PVSTRING SCRIPTNAME="LIGHT_NAME"       DEFAULTNAME="Name" ACCESS="Read" SAVE="1" EXPORT="1"/>
				<PVANALOG SCRIPTNAME="LIGHT_POLL_INTERVAL" UNIT="[0..3600]" DEFAULTNAME="Abfrageintervall s" ACCESS="Read/Write" SAVE="1" EXPORT="1" DESCRIPTION="Sekunden zwischen automatischen Status-Abfragen dieser Lampe, Standard 10s bei neu angelegten Instanzen. 0 = kein automatisches Polling (Status nur einmalig beim Start bzw. ueber Status aktualisieren)"/>
				<PVBINARY SCRIPTNAME="LIGHT_ON_CMD"         UNIT0="aus" UNIT1="an" DEFAULTNAME="Ein/Aus" ACCESS="Write" SAVE="0" EXPORT="1" DESCRIPTION="Sendedatenpunkt: schaltet die Lampe"/>
				<PVBINARY SCRIPTNAME="LIGHT_ON"             UNIT0="aus" UNIT1="an" DEFAULTNAME="Ein/Aus (Rückmeldung)" ACCESS="Read" SAVE="1" EXPORT="1" DESCRIPTION="Empfangsdatenpunkt: aktueller Schaltzustand laut Bridge"/>
				<PVANALOG SCRIPTNAME="LIGHT_BRIGHTNESS_CMD" UNIT="[0..100]" DEFAULTNAME="Helligkeit %" ACCESS="Write" SAVE="0" EXPORT="1" DESCRIPTION="Sendedatenpunkt: setzt die Helligkeit"/>
				<PVANALOG SCRIPTNAME="LIGHT_BRIGHTNESS"     UNIT="[0..100]" DEFAULTNAME="Helligkeit % (Rückmeldung)" ACCESS="Read" SAVE="1" EXPORT="1" DESCRIPTION="Empfangsdatenpunkt: aktuelle Helligkeit laut Bridge"/>
				<PVANALOG SCRIPTNAME="LIGHT_COLORTEMP_CMD"  UNIT="[2000..6500]" DEFAULTNAME="Farbtemperatur K" ACCESS="Write" SAVE="0" EXPORT="1" DESCRIPTION="Sendedatenpunkt: setzt die Farbtemperatur in Kelvin (2000=warmweiss .. 6500=kaltweiss)"/>
				<PVANALOG SCRIPTNAME="LIGHT_COLORTEMP"      UNIT="[2000..6500]" DEFAULTNAME="Farbtemperatur K (Rückmeldung)" ACCESS="Read" SAVE="1" EXPORT="1" DESCRIPTION="Empfangsdatenpunkt: aktuelle Farbtemperatur laut Bridge"/>
				<PVANALOG SCRIPTNAME="LIGHT_HUEANGLE_CMD"   UNIT="[0..360]" DEFAULTNAME="Farbton" ACCESS="Write" SAVE="0" EXPORT="1" DESCRIPTION="Sendedatenpunkt: setzt den Farbton in Grad (0..360), nur bei Vollfarbenlampen"/>
				<PVANALOG SCRIPTNAME="LIGHT_HUEANGLE"       UNIT="[0..360]" DEFAULTNAME="Farbton (Rückmeldung)" ACCESS="Read" SAVE="1" EXPORT="1" DESCRIPTION="Empfangsdatenpunkt: aktueller Farbton laut Bridge"/>
				<PVANALOG SCRIPTNAME="LIGHT_SATURATION_CMD" UNIT="[0..100]" DEFAULTNAME="Sättigung %" ACCESS="Write" SAVE="0" EXPORT="1" DESCRIPTION="Sendedatenpunkt: setzt die Sättigung, nur bei Vollfarbenlampen"/>
				<PVANALOG SCRIPTNAME="LIGHT_SATURATION"     UNIT="[0..100]" DEFAULTNAME="Sättigung % (Rückmeldung)" ACCESS="Read" SAVE="1" EXPORT="1" DESCRIPTION="Empfangsdatenpunkt: aktuelle Sättigung laut Bridge"/>
				<PVBINARY SCRIPTNAME="LIGHT_REACHABLE"      UNIT0="nicht erreichbar" UNIT1="erreichbar" DEFAULTNAME="Erreichbar" ACCESS="Read" SAVE="0" EXPORT="1"/>
				<PVTIME   SCRIPTNAME="LIGHT_LASTUPDATE" UNIT0="" DEFAULTNAME="Letztes Update" ACCESS="Read" SAVE="0" EXPORT="1"/>
			</PVFOLDER>
		</PVFOLDER>

		<PVFOLDER SCRIPTNAME="GROUPS_ROOT" CREATIONTYPE="Unique" USERTYPE="groups_root_t" DEFAULTNAME="Räume/Gruppen">
			<PVFOLDER SCRIPTNAME="Group" CREATIONTYPE="Multiple" USERTYPE="group_t" DEFAULTNAME="Gruppe/Raum">
				<PVSTRING SCRIPTNAME="GROUP_HUE_ID"     DEFAULTNAME="Hue Group-ID" ACCESS="Read/Write" SAVE="1" EXPORT="1" DESCRIPTION="ID der Gruppe/des Raums auf der Bridge"/>
				<PVSTRING SCRIPTNAME="GROUP_NAME"       DEFAULTNAME="Name" ACCESS="Read" SAVE="1" EXPORT="1"/>
				<PVBINARY SCRIPTNAME="GROUP_ON_CMD"         UNIT0="aus" UNIT1="an" DEFAULTNAME="Ein/Aus" ACCESS="Write" SAVE="0" EXPORT="1" DESCRIPTION="Sendedatenpunkt: schaltet die Gruppe/den Raum"/>
				<PVBINARY SCRIPTNAME="GROUP_ON"             UNIT0="aus" UNIT1="an" DEFAULTNAME="Ein/Aus (Rückmeldung)" ACCESS="Read" SAVE="1" EXPORT="1" DESCRIPTION="Empfangsdatenpunkt: aktueller Schaltzustand laut Bridge"/>
				<PVANALOG SCRIPTNAME="GROUP_BRIGHTNESS_CMD" UNIT="[0..100]" DEFAULTNAME="Helligkeit %" ACCESS="Write" SAVE="0" EXPORT="1" DESCRIPTION="Sendedatenpunkt: setzt die Helligkeit der Gruppe/des Raums"/>
				<PVANALOG SCRIPTNAME="GROUP_BRIGHTNESS"     UNIT="[0..100]" DEFAULTNAME="Helligkeit % (Rückmeldung)" ACCESS="Read" SAVE="1" EXPORT="1" DESCRIPTION="Empfangsdatenpunkt: aktuelle Helligkeit laut Bridge"/>
				<PVBINARY SCRIPTNAME="GROUP_ANY_ON"     UNIT0="alle aus" UNIT1="mind. eine an" DEFAULTNAME="Irgendeine an" ACCESS="Read" SAVE="0" EXPORT="1"/>
				<PVBINARY SCRIPTNAME="GROUP_ALL_ON"     UNIT0="nicht alle an" UNIT1="alle an" DEFAULTNAME="Alle an" ACCESS="Read" SAVE="0" EXPORT="1"/>
			</PVFOLDER>
		</PVFOLDER>

		<PVFOLDER SCRIPTNAME="SCENES_ROOT" CREATIONTYPE="Unique" USERTYPE="scenes_root_t" DEFAULTNAME="Szenen">
			<PVFOLDER SCRIPTNAME="Scene" CREATIONTYPE="Multiple" USERTYPE="scene_t" DEFAULTNAME="Szene">
				<PVSTRING SCRIPTNAME="SCENE_HUE_ID"          DEFAULTNAME="Hue Scene-ID" ACCESS="Read/Write" SAVE="1" EXPORT="1" DESCRIPTION="ID der Szene auf der Bridge"/>
				<PVSTRING SCRIPTNAME="SCENE_TARGET_GROUP_ID" DEFAULTNAME="Ziel-Gruppen-ID" ACCESS="Read/Write" SAVE="1" EXPORT="1" DESCRIPTION="Gruppe/Raum, in der die Szene aufgerufen wird (0 = alle Lampen). Wird beim Nachladen automatisch von der Bridge übernommen, sofern die Szene einem Raum zugeordnet ist - bei raumlosen Szenen (Lampen-Szenen) bleibt der manuell eingetragene Wert bestehen"/>
				<PVSTRING SCRIPTNAME="SCENE_NAME"            DEFAULTNAME="Name" ACCESS="Read" SAVE="1" EXPORT="1"/>
				<PVSTRING SCRIPTNAME="SCENE_GROUP_NAME"      DEFAULTNAME="Raum" ACCESS="Read" SAVE="1" EXPORT="1" DESCRIPTION="Name des Raums/der Gruppe, zu der die Szene gehört (aufgelöst aus Ziel-Gruppen-ID) - zur Unterscheidung gleichnamiger Szenen in verschiedenen Räumen, z.B. mehrfach vorhandenes 'Nachtlicht'"/>
				<PVBINARY SCRIPTNAME="SCENE_ACTIVATE"        UNIT0="-" UNIT1="Start" DEFAULTNAME="Aktivieren" ACCESS="Write" SAVE="0" EXPORT="1"/>
			</PVFOLDER>
		</PVFOLDER>

		<PVFOLDER SCRIPTNAME="SENSORS_ROOT" CREATIONTYPE="Unique" USERTYPE="sensors_root_t" DEFAULTNAME="Sensoren">
			<PVFOLDER SCRIPTNAME="Sensor" CREATIONTYPE="Multiple" USERTYPE="sensor_t" DEFAULTNAME="Sensor">
				<PVSTRING SCRIPTNAME="SENSOR_HUE_ID"        DEFAULTNAME="Hue Sensor-ID" ACCESS="Read/Write" SAVE="1" EXPORT="1" DESCRIPTION="ID des Sensors auf der Bridge"/>
				<PVSTRING SCRIPTNAME="SENSOR_NAME"          DEFAULTNAME="Name" ACCESS="Read" SAVE="1" EXPORT="1"/>
				<PVSTRING SCRIPTNAME="SENSOR_TYPE"          DEFAULTNAME="Typ" ACCESS="Read" SAVE="0" EXPORT="1" DESCRIPTION="z.B. ZLLPresence (Bewegung), ZLLTemperature, ZLLLightLevel, ZLLSwitch/ZHASwitch (Taster/Fernbedienung/Türklingel), ZHAOpenClose/CLIPOpenClose (Fensterkontakt), Daylight"/>
				<PVSTRING SCRIPTNAME="SENSOR_VALUE"         DEFAULTNAME="Wert (Text)" ACCESS="Read" SAVE="0" EXPORT="1"/>
				<PVANALOG SCRIPTNAME="SENSOR_NUMERICVALUE"  UNIT="[-1000..100000]" DEFAULTNAME="Wert (numerisch)" ACCESS="Read" SAVE="0" EXPORT="1" DESCRIPTION="Temperatur in °C, Lux, Präsenz/Kontakt 0/1 oder Button-Event, je nach Typ"/>
				<PVBINARY SCRIPTNAME="SENSOR_CONTACT"       UNIT0="geschlossen" UNIT1="offen" DEFAULTNAME="Kontakt (Fenster/Tür)" ACCESS="Read" SAVE="0" EXPORT="1" DESCRIPTION="Nur bei Fensterkontakten gesetzt (Typ ZHAOpenClose/CLIPOpenClose): 1=offen, 0=geschlossen"/>
				<PVANALOG SCRIPTNAME="SENSOR_BATTERY"       UNIT="[0..100]" DEFAULTNAME="Batterie %" ACCESS="Read" SAVE="0" EXPORT="1"/>
				<PVTIME   SCRIPTNAME="SENSOR_LASTUPDATED"   UNIT0="" DEFAULTNAME="Letztes Update" ACCESS="Read" SAVE="0" EXPORT="1"/>
			</PVFOLDER>
		</PVFOLDER>

		<PVFOLDER SCRIPTNAME="AUTOMATIONS_ROOT" CREATIONTYPE="Unique" USERTYPE="automations_root_t" DEFAULTNAME="Automationen">
			<PVFOLDER SCRIPTNAME="Automation" CREATIONTYPE="Multiple" USERTYPE="automation_t" DEFAULTNAME="Automation">
				<PVSTRING SCRIPTNAME="AUTOMATION_HUE_ID"         DEFAULTNAME="Hue Rule-ID" ACCESS="Read/Write" SAVE="1" EXPORT="1" DESCRIPTION="ID der Regel/Automation auf der Bridge"/>
				<PVSTRING SCRIPTNAME="AUTOMATION_NAME"           DEFAULTNAME="Name" ACCESS="Read" SAVE="1" EXPORT="1"/>
				<PVBINARY SCRIPTNAME="AUTOMATION_ENABLED_CMD"    UNIT0="deaktiviert" UNIT1="aktiviert" DEFAULTNAME="Aktiv" ACCESS="Write" SAVE="0" EXPORT="1" DESCRIPTION="Sendedatenpunkt: aktiviert/deaktiviert die Automation"/>
				<PVBINARY SCRIPTNAME="AUTOMATION_ENABLED"        UNIT0="deaktiviert" UNIT1="aktiviert" DEFAULTNAME="Aktiv (Rückmeldung)" ACCESS="Read" SAVE="1" EXPORT="1" DESCRIPTION="Empfangsdatenpunkt: aktueller Zustand laut Bridge"/>
				<PVANALOG SCRIPTNAME="AUTOMATION_TIMESTRIGGERED" UNIT="[0..999999999]" DEFAULTNAME="Anzahl Auslösungen" ACCESS="Read" SAVE="1" EXPORT="1"/>
				<PVTIME   SCRIPTNAME="AUTOMATION_LASTTRIGGERED"  UNIT0="" DEFAULTNAME="Zuletzt ausgelöst" ACCESS="Read" SAVE="0" EXPORT="1" DESCRIPTION="Zeitpunkt, zu dem JVP die letzte Auslösung erkannt hat"/>
			</PVFOLDER>
		</PVFOLDER>
	</PVITEMS>

	<RESOURCES>
		<HTTP SCRIPTNAME="HTTP" USERTYPE="http_rq" DEFAULTNAME="HTTP Requester"/>
	</RESOURCES>
</SDVINTERFACE>
